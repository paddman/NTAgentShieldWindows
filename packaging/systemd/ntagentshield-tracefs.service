[Unit]
Description=NTAgentShield narrow tracefs read-access provisioning
Documentation=https://github.com/paddman/NTAgentShieldLinux
DefaultDependencies=no
After=sys-kernel-tracing.mount
Before=ntagentshield-sensor.service
ConditionPathIsMountPoint=/sys/kernel/tracing

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/ntagentshield-sensor --prepare-tracefs
RemainAfterExit=yes
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
