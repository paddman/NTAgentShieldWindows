[Unit]
Description=NTAgentShield restricted Linux telemetry sensor
Documentation=https://github.com/paddman/NTAgentShieldLinux
Wants=ntagentshield-tracefs.service
After=systemd-tmpfiles-setup.service ntagentshield-tracefs.service
Before=ntagentshield-agent.service

[Service]
Type=simple
User=ntagentshield-sensor
Group=ntagentshield-ipc
SupplementaryGroups=ntagentshield-sensor
ExecStart=/usr/bin/ntagentshield-sensor --config /etc/ntagentshield/agent.json --allow-user ntagentshield-agent
Restart=on-failure
RestartSec=60s
UMask=0007
RuntimeDirectory=ntagentshield-sensor
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/ntagentshield-sensor
ReadOnlyPaths=/proc /sys/kernel/btf /etc/ntagentshield
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
AmbientCapabilities=CAP_BPF CAP_PERFMON
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
