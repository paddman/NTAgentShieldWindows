{
  "agent_id": "",
  "tenant_id": "demo-tenant",
  "data_dir": "../data",
  "poll_interval": "1s",
  "detection": {
    "auth_failure_threshold": 6,
    "auth_failure_window": "5m"
  },
  "sources": [],
  "api": {
    "enabled": false,
    "listen": "127.0.0.1:9477",
    "token_file": "agent-api.token"
  },
  "tools": {
    "policy_file": "../policies/default-policy.json",
    "allowed_paths": [
      "../examples",
      "../data"
    ]
  },
  "ai": {
    "enabled": true,
    "endpoint": "http://127.0.0.1:8000/v1",
    "model": "Qwen/Qwen3-8B",
    "api_key_env": "NTAGENTSHIELD_AI_API_KEY",
    "api_key_file": "llm-api.token",
    "allow_remote": false,
    "timeout": "60s",
    "auto_analyze": true,
    "minimum_severity": "high",
    "queue_size": 64,
    "min_interval": "30s",
    "audit_log_file": "llm.audit.jsonl"
  }
}
